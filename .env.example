# Kopiere diese Datei nach .env und trage deine Zugangsdaten ein.
# Die Datei .env bleibt auf deinem Rechner und wird nicht mit der App ausgeliefert.

# Microsoft Azure Speech (empfohlen, Gratis-Kontingent reicht für den ganzen Kurs)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# ElevenLabs (optional, sehr warme Stimmen, kostenpflichtig)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_LABEL=
